<?xml version="1.0"?>
<!--
  Small indoor test room: one 6x5 m space, a doorway, and two furniture-sized
  obstacles. Deliberately simple. It exists to exercise mapping, localization
  and the safety gate before any of that runs on hardware, not to look like a
  real house.
-->
<sdf version="1.9">
  <world name="test_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.75 0.80 0.83 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.75 0.73 0.68 1</ambient>
            <diffuse>0.80 0.78 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room shell. Walls are 0.1 m thick and 1.2 m tall: above the lidar
         plane at 0.22 m, which is all the 2D safety layer can see. -->
    <model name="walls">
      <static>true</static>
      <link name="link">

        <collision name="north"><pose>0 2.5 0.6 0 0 0</pose>
          <geometry><box><size>6.0 0.1 1.2</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 2.5 0.6 0 0 0</pose>
          <geometry><box><size>6.0 0.1 1.2</size></box></geometry>
          <material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.62 0.64 0.65 1</diffuse></material></visual>

        <collision name="south"><pose>0 -2.5 0.6 0 0 0</pose>
          <geometry><box><size>6.0 0.1 1.2</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -2.5 0.6 0 0 0</pose>
          <geometry><box><size>6.0 0.1 1.2</size></box></geometry>
          <material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.62 0.64 0.65 1</diffuse></material></visual>

        <collision name="west"><pose>-3.0 0 0.6 0 0 0</pose>
          <geometry><box><size>0.1 5.0 1.2</size></box></geometry></collision>
        <visual name="west_visual"><pose>-3.0 0 0.6 0 0 0</pose>
          <geometry><box><size>0.1 5.0 1.2</size></box></geometry>
          <material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.62 0.64 0.65 1</diffuse></material></visual>

        <!-- East wall split to leave a 0.9 m doorway centred at y = 0. -->
        <collision name="east_lower"><pose>3.0 -1.55 0.6 0 0 0</pose>
          <geometry><box><size>0.1 1.9 1.2</size></box></geometry></collision>
        <visual name="east_lower_visual"><pose>3.0 -1.55 0.6 0 0 0</pose>
          <geometry><box><size>0.1 1.9 1.2</size></box></geometry>
          <material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.62 0.64 0.65 1</diffuse></material></visual>

        <collision name="east_upper"><pose>3.0 1.55 0.6 0 0 0</pose>
          <geometry><box><size>0.1 1.9 1.2</size></box></geometry></collision>
        <visual name="east_upper_visual"><pose>3.0 1.55 0.6 0 0 0</pose>
          <geometry><box><size>0.1 1.9 1.2</size></box></geometry>
          <material><ambient>0.55 0.57 0.58 1</ambient><diffuse>0.62 0.64 0.65 1</diffuse></material></visual>

      </link>
    </model>

    <!-- Furniture-sized obstacles for obstacle-avoidance and stop tests. -->
    <model name="table">
      <static>true</static>
      <pose>-1.2 1.0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><pose>0 0 0.35 0 0 0</pose>
          <geometry><box><size>1.2 0.7 0.7</size></box></geometry></collision>
        <visual name="visual"><pose>0 0 0.35 0 0 0</pose>
          <geometry><box><size>1.2 0.7 0.7</size></box></geometry>
          <material><ambient>0.45 0.32 0.22 1</ambient><diffuse>0.52 0.37 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cabinet">
      <static>true</static>
      <pose>1.6 -1.4 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.5 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.5 1.0 0.9</size></box></geometry>
          <material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.48 0.50 0.53 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
