<?xml version="1.0"?>
<package format="3">
  <name>robot_base</name>
  <version>0.1.0</version>
  <description>Driver for the mecanum base: the safety gate's /cmd_vel to the Pico's wheels, and encoders to /odom.</description>
  <maintainer email="andymuji@users.noreply.github.com">andymuji</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
