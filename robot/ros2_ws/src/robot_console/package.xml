<?xml version="1.0"?>
<package format="3">
  <name>robot_console</name>
  <version>0.1.0</version>
  <description>Operator console served against a live ROS graph.</description>
  <maintainer email="andymuji@users.noreply.github.com">andymuji</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_core</exec_depend>
  <exec_depend>robot_locations</exec_depend>
  <exec_depend>robot_voice</exec_depend>
  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
