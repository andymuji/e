<?xml version="1.0"?>
<package format="3">
  <name>robot_telemetry</name>
  <version>0.1.0</version>
  <description>Records safety-relevant runs and checks the recordings against the safety invariants.</description>
  <maintainer email="andymuji@users.noreply.github.com">andymuji</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>robot_safety</exec_depend>
  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
