__pycache__/
*.py[cod]
.venv/

# Local lint cache.
.ruff_cache/

# colcon build artifacts
build/
install/
log/

# Personal Claude Code overrides; .claude/settings.json is shared and committed.
.claude/settings.local.json

# Per-agent git worktrees created by Claude Code sessions.
.claude/worktrees/

# Phone scans of rooms (Polycam .glb, or the .zip it is sent in). The
# repository is public, and a textured scan shows inside someone's home: see
# docs/privacy.md. The 2026-10-05 test patch is bare floor and balls, and the
# tests use it.
docs/runs/*.glb
docs/runs/*.zip
!docs/runs/10_5_2026.glb
